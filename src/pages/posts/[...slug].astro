---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const projectPage = 'exploring-hopfield-networks';
const showProjectLink = post.data.series === 'comp-neuro' && post.id !== projectPage;
---
<Base title={post.data.title} noindex={post.data.unlisted}>
  {showProjectLink && <Fragment slot="nav"> · <a href={`/posts/${projectPage}/`}>Exploring Hopfield networks</a></Fragment>}
  <h1>{post.data.title}</h1>
  {post.data.course && <p class="banner">Written for {post.data.course}.</p>}
  <article><Content /></article>
</Base>

<script>
  if (document.querySelector('[data-widget^="ising"]')) import('../../scripts/ising.ts');
</script>

<style is:global>
  /* Plain "> text" blockquotes: asides. */
  article blockquote { margin: 1.25rem 0; padding: .4rem 1rem; background: #f6f6f3; border-left: 3px solid #c8c8c0; font-size: .92em; color: #444; }
  article blockquote > :first-child { margin-top: 0; }
  article blockquote > :last-child { margin-bottom: 0; }

  /* Obsidian callouts: > [!type] Title */
  .callout { margin: 1.5rem 0; padding: .75rem 1rem; border: 1px solid #d8dde6; border-left: 3px solid #1a4f8b; border-radius: 3px; background: #f7f9fc; }
  .callout-title { font-weight: bold; }

  /* "> [!Theorem] Title": bold type, italic title. */
  .callout-label { font-weight: bold; }
  .callout-name { font-weight: normal; font-style: italic; }
  /* Proofs end with a QED box. */
  .callout-proof .callout-body::after { content: '∎'; display: block; text-align: right; margin-top: -1.6em; }
  .callout-body > :first-child { margin-top: .4rem; }
  .callout-body > :last-child { margin-bottom: 0; }
  details.callout > summary { cursor: pointer; }

  /* Tables */
  article table { border-collapse: collapse; margin: 1.25rem auto; font-size: .95em; }
  article th, article td { padding: .35rem .9rem; border-bottom: 1px solid #ddd; }
  article thead th { border-bottom: 2px solid #999; }
  article tbody tr:last-child td { border-bottom: 0; }

  /* Widgets */
  .widget { margin: 1.5rem auto; width: min(100%, 320px); }
  .widget canvas { display: block; width: 100%; aspect-ratio: 1; border: 1px solid #ccc; }
  .widget-control { display: flex; flex-direction: column; gap: .2rem; margin-top: .5rem; font-size: .9em; }
  .widget-control input { width: 100%; }
  .widget-row { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin: .5rem 0 0; font-size: .85em; color: #555; }
</style>
