---
import 'katex/dist/katex.min.css';
interface Props { title: string; noindex?: boolean }
const { title, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <style is:global>
      body { max-width: 42rem; margin: 2rem auto; padding: 0 1rem; font: 17px/1.6 Georgia, serif; color: #222; background: #fff; }
      a { color: #1a4f8b; }
      h1, h2 { font-weight: normal; }
      .banner { border-left: 3px solid #999; padding: .25rem .75rem; background: #f4f4f4; }
    </style>
  </head>
  <body>
    {Astro.url.pathname !== '/' && <p><a href="/">← home</a></p>}
    <slot />
  </body>
</html>
